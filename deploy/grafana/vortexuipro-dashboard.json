{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "2.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time Series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar Gauge", "version": "" },
    { "type": "panel", "id": "heatmap", "name": "Heatmap", "version": "" }
  ],
  "annotations": { "list": [] },
  "title": "VortexUiPro / Overview",
  "uid": "vortexuipro-main",
  "version": 2,
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "panels": [
    {
      "id": 1,
      "title": "System Uptime",
      "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 0, "y": 0 },
      "targets": [{ "expr": "vortexuipro_uptime_seconds", "legendFormat": "uptime" }],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 86400 },
            { "color": "green", "value": 604800 }
          ]},
          "mappings": [],
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 2,
      "title": "Total Users",
      "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 3, "y": 0 },
      "targets": [{ "expr": "vortexuipro_users_total", "legendFormat": "total" }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }
          ]}
        }
      }
    },
    {
      "id": 3,
      "title": "Active Users",
      "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 6, "y": 0 },
      "targets": [{ "expr": "vortexuipro_users_active", "legendFormat": "active" }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "blue", "value": null }
          ]}
        }
      }
    },
    {
      "id": 4,
      "title": "Online Nodes",
      "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 9, "y": 0 },
      "targets": [{ "expr": "vortexuipro_nodes_online", "legendFormat": "online" }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }
          ]}
        }
      }
    },
    {
      "id": 5,
      "title": "Active Connections",
      "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 12, "y": 0 },
      "targets": [{ "expr": "vortexuipro_connections_active", "legendFormat": "conns" }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1000 },
            { "color": "red", "value": 5000 }
          ]}
        }
      }
    },
    {
      "id": 6,
      "title": "Total Traffic",
      "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 15, "y": 0 },
      "targets": [{ "expr": "vortexuipro_traffic_bytes_total", "legendFormat": "total" }],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 2,
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 7,
      "title": "Memory Usage",
      "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 18, "y": 0 },
      "targets": [{ "expr": "process_resident_memory_bytes{job=~\"vortexuipro|panel\"}", "legendFormat": "memory" }],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 500000000 },
            { "color": "red", "value": 1000000000 }
          ]}
        }
      }
    },
    {
      "id": 8,
      "title": "CPU Usage",
      "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 21, "y": 0 },
      "targets": [{ "expr": "rate(process_cpu_seconds_total{job=~\"vortexuipro|panel\"}[1m]) * 100", "legendFormat": "cpu %" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "red", "value": 80 }
          ]}
        }
      }
    },
    {
      "id": 10,
      "title": "Traffic Rate (5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "targets": [
        { "expr": "rate(vortexuipro_traffic_bytes_total[5m])", "legendFormat": "rate" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 2,
          "custom": { "lineInterpolation": "smooth", "fillOpacity": 20, "pointSize": 0 }
        }
      },
      "options": { "legend": { "calcs": ["min", "max", "avg", "last"], "displayMode": "table", "placement": "bottom" } }
    },
    {
      "id": 11,
      "title": "Active Connections Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "targets": [{ "expr": "vortexuipro_connections_active", "legendFormat": "connections" }],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineInterpolation": "smooth", "fillOpacity": 20 }
        }
      }
    },
    {
      "id": 12,
      "title": "Users Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "targets": [
        { "expr": "vortexuipro_users_total", "legendFormat": "total" },
        { "expr": "vortexuipro_users_active", "legendFormat": "active" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineInterpolation": "smooth", "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 13,
      "title": "Node Health",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "targets": [
        { "expr": "vortexuipro_nodes_total", "legendFormat": "total" },
        { "expr": "vortexuipro_nodes_online", "legendFormat": "online" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineInterpolation": "stepAfter", "fillOpacity": 20 }
        }
      }
    },
    {
      "id": 14,
      "title": "Top Users by Traffic",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "targets": [{ "expr": "topk(10, vortexuipro_user_traffic_bytes)", "legendFormat": "{{username}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "align": "auto" }
        }
      }
    },
    {
      "id": 15,
      "title": "Inbound Traffic Distribution",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "targets": [{ "expr": "topk(10, vortexuipro_inbound_traffic_bytes)", "legendFormat": "{{inbound}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": { "mode": "percentage", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "red", "value": 80 }
          ]}
        }
      }
    },
    {
      "id": 16,
      "title": "Connection Heatmap (Hourly)",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "targets": [{ "expr": "rate(vortexuipro_connections_active[1h])", "legendFormat": "conns" }],
      "fieldConfig": {
        "defaults": {
          "custom": { "hideFrom": { "tooltip": false, "viz": false, "legend": false } }
        }
      }
    },
    {
      "id": 17,
      "title": "Cluster Heartbeat Latency",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 35 },
      "targets": [{ "expr": "vortexuipro_cluster_heartbeat_latency_ms", "legendFormat": "{{node}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineInterpolation": "smooth" }
        }
      }
    },
    {
      "id": 18,
      "title": "Event Rate (System Events)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 35 },
      "targets": [{ "expr": "rate(vortexuipro_events_total[5m])", "legendFormat": "{{type}}" }],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineInterpolation": "smooth", "fillOpacity": 10 }
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "value": "$DS_PROMETHEUS" }
      }
    ]
  },
  "links": [
    { "title": "VortexUiPro Panel", "url": "http://localhost:8080" },
    { "title": "GitHub", "url": "https://github.com/iPmartNetwork/VortexUiPro" }
  ]
}
