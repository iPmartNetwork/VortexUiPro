[Unit]
Description=VortexUiPro Panel — Next-Gen Proxy Management
Documentation=https://github.com/iPmartNetwork/VortexUiPro
After=network.target network-online.target postgresql.service redis.service
Wants=network-online.target
Requires=

[Service]
Type=simple

# Environment file (copy from .env.example)
EnvironmentFile=-/etc/vortexuipro/env
EnvironmentFile=-/etc/vortexuipro/panel.env
EnvironmentFile=-/opt/vortexuipro/.env

# Binary and working directory
ExecStart=/usr/local/bin/vortexuipro
ExecReload=/bin/kill -HUP $MAINPID
WorkingDirectory=/opt/vortexuipro

# User and group
User=vortexuipro
Group=vortexuipro

# Restart policy
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_SYS_PTRACE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# File descriptor limits
LimitNOFILE=65535
LimitNPROC=4096

# Timeouts
TimeoutStartSec=30
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vortexuipro

[Install]
WantedBy=multi-user.target
